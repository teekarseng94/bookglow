# Optional local overrides for Vite (customer site).
# Copy to `.env` and fill values locally. Do not commit secrets.

# Gemini (build-time define via vite.config)
GEMINI_API_KEY=

# Supabase (foundation only — default providers stay Firebase)
# Publishable/anon key only. Never put service_role / secret keys in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias (optional): VITE_SUPABASE_ANON_KEY=
VITE_DATA_PROVIDER=firebase
VITE_AUTH_PROVIDER=firebase
# For full public booking on Supabase (reads + write + reviews + auth), set both to supabase:
# VITE_DATA_PROVIDER=supabase
# VITE_AUTH_PROVIDER=supabase
