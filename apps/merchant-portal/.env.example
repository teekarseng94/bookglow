# Optional local overrides for Vite (merchant portal).
# Copy to `.env` and fill values locally. Do not commit secrets.

# Gemini (build-time define via vite.config — keep out of public client if possible)
GEMINI_API_KEY=

# Optional realtime socket endpoint (browser-visible if set with VITE_)
VITE_SOCKET_URL=

# Supabase — publishable/anon key only. Never put service_role / secret keys in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias (optional): VITE_SUPABASE_ANON_KEY=

# Providers: firebase (safe default / rollback) | supabase (local cutover)
VITE_DATA_PROVIDER=firebase
VITE_AUTH_PROVIDER=firebase

# Local Supabase cutover (Phases 1–5):
# VITE_DATA_PROVIDER=supabase
# VITE_AUTH_PROVIDER=supabase
# Insert public.users (uid, outlet_id, role) for each Auth user.
# Import data: cd migration && npm run import:merchant-phase5
