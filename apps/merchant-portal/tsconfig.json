{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@bookglow/auth-contracts": [
        "../../packages/auth-contracts/src/index.ts"
      ],
      "@bookglow/database-contracts": [
        "../../packages/database-contracts/src/index.ts"
      ],
      "@bookglow/shared-types": [
        "../../packages/shared-types/src/index.ts"
      ],
      "@bookglow/supabase": [
        "../../packages/supabase/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./vite-env.d.ts",
    "../customer-site/apps/merchant-onboarding/**/*.ts",
    "../customer-site/apps/merchant-onboarding/**/*.tsx",
    "../customer-site/services/merchantOnboardingService.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "functions",
    "android",
    "pages/ExternalIntegrations.tsx",
    "services/firestoreService.ts"
  ]
}
