{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "node scripts/vercel-frontend.mjs install",
  "buildCommand": "node scripts/vercel-frontend.mjs build",
  "outputDirectory": "dist-vercel",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/((?:loginbackend|login|onboarding|dashboard|pos|schedule|appointments|finance|staff|member|menu|marketing|services|crm|sales-reports|transactions|reports|report|settings|integrations|member-details|access|admin|auth/callback/merchant|buy-voucher|redeem|merchant-assets)(?:/.*)?)$",
      "has": [{ "type": "host", "value": "^(www\\.)?bookglow\\.my$" }],
      "dest": "https://bookglow-merchant.vercel.app/$1"
    },
    {
      "src": "/merchant-assets/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/signup/?",
      "dest": "/index.html"
    },
    {
      "src": "/(?:privacy|account-deletion)/?",
      "dest": "/index.html"
    },
    {
      "src": "/(?:auth/callback/customer)/?",
      "dest": "/index.html"
    },
    {
      "src": "/book/[^/]+(?:/auth)?/?",
      "dest": "/index.html"
    },
    {
      "src": "/assets/(.*)",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "build": {
    "env": {
      "VITE_SUPABASE_URL": "https://uecphpjymbgtttrizhgy.supabase.co",
      "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_B6tTdRL9dDtvWZdZ18ScrA_9FnZ-T6b",
      "VITE_AUTH_GOOGLE_ENABLED": "true",
      "VITE_AUTH_FACEBOOK_ENABLED": "false",
      "VITE_DATA_PROVIDER": "supabase",
      "VITE_AUTH_PROVIDER": "supabase",
      "VITE_CUSTOMER_SITE_URL": "https://bookglow.my",
      "VITE_CUSTOMER_AUTH_CALLBACK_URL": "https://bookglow.my/auth/callback/customer",
      "VITE_MERCHANT_PORTAL_URL": "https://bookglow.my",
      "VITE_MERCHANT_AUTH_CALLBACK_URL": "https://bookglow.my/auth/callback/merchant"
    }
  },
  "env": {
    "VITE_SUPABASE_URL": "https://uecphpjymbgtttrizhgy.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_B6tTdRL9dDtvWZdZ18ScrA_9FnZ-T6b",
    "VITE_AUTH_GOOGLE_ENABLED": "true",
    "VITE_AUTH_FACEBOOK_ENABLED": "false",
    "VITE_DATA_PROVIDER": "supabase",
    "VITE_AUTH_PROVIDER": "supabase",
    "VITE_CUSTOMER_SITE_URL": "https://bookglow.my",
    "VITE_CUSTOMER_AUTH_CALLBACK_URL": "https://bookglow.my/auth/callback/customer",
    "VITE_MERCHANT_PORTAL_URL": "https://bookglow.my",
    "VITE_MERCHANT_AUTH_CALLBACK_URL": "https://bookglow.my/auth/callback/merchant"
  }
}
