{
  "name": "zenflow-spa-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=20480 vite build",
    "build:no-cache": "npx --yes rimraf node_modules/.vite && cross-env NODE_OPTIONS=--max-old-space-size=20480 vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "verify": "npm run typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:all": "npm run build && firebase deploy --only hosting,functions",
    "install:functions": "npm install --prefix functions",
    "deploy:functions": "npm run install:functions && cross-env FUNCTIONS_DISCOVERY_TIMEOUT=60 firebase deploy --only functions"
  },
  "dependencies": {
    "@bookglow/auth-contracts": "file:../../packages/auth-contracts",
    "@bookglow/database-contracts": "file:../../packages/database-contracts",
    "@bookglow/shared-types": "file:../../packages/shared-types",
    "@bookglow/supabase": "file:../../packages/supabase",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "1.3.0",
    "firebase": "^10.14.1",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^6.30.3",
    "recharts": "2.12.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "jsdom": "^30.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
