# Optional local overrides for Vite (customer site).
# Copy to `.env` and fill values locally. Do not commit secrets.

# Gemini (build-time define via vite.config)
GEMINI_API_KEY=

# Supabase — publishable/anon key only. Never put service_role / secret keys in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias (optional): VITE_SUPABASE_ANON_KEY=

# Cross-app navigation. Use the deployed merchant portal origin in staging/production.
VITE_MERCHANT_PORTAL_URL=http://localhost:5173

# Optional merchant OAuth buttons. Set true only after Google is enabled in
# Supabase Auth → Providers and redirect URLs include /signup.
# Production customer deploys also read these from root vercel.json `env`.
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_FACEBOOK_ENABLED=false
VITE_CUSTOMER_AUTH_CALLBACK_URL=http://localhost:5174/auth/callback/customer

# Providers (always supabase in Phase D+; kept for shared-types compatibility)
VITE_DATA_PROVIDER=supabase
VITE_AUTH_PROVIDER=supabase
